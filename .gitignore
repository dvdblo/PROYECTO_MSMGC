
# Dependencias de Node.js
node_modules/
**/node_modules/

# Archivos de entorno (variables y secretos)
.env
.env.*
!.env.example

# Builds y archivos generados
dist/
**/dist/
build/
**/build/

# Caché
.cache/
.vite/
**/.vite/
.eslintcache

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# Archivos temporales
.tmp/
temp/
*.tmp

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Cobertura de pruebas
coverage/

# Certificados y llaves privadas
*.key
*.pem
*.p12
*.pfx

# Python (por si hay scripts)
__pycache__/
*.py[cod]
venv/
.venv/

# Archivos de respaldo
*.bak
*.old
*.swp
